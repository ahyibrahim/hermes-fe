{
  "name": "@hermes/web",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "Hermes web UI. A static SvelteKit SPA served by hermes-be.",
  "scripts": {
    "dev": "vite dev --host",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "sync": "svelte-kit sync",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['build','.svelte-kit']) { fs.rmSync(p,{recursive:true,force:true}); }\""
  },
  "dependencies": {
    "@hermes/core": "^0.7.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "2.16.1",
    "@sveltejs/vite-plugin-svelte": "4.0.4",
    "svelte": "5.16.2",
    "svelte-check": "4.1.1",
    "typescript": "^5.7.3",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=18.19.0"
  }
}
