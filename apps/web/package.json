{
  "name": "@hermes/web",
  "version": "0.29.0",
  "private": true,
  "type": "module",
  "description": "Hermes web UI. A static SvelteKit SPA served by hermes-be.",
  "scripts": {
    "dev": "vite dev --host",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "svelte-kit sync && vitest run",
    "sync": "svelte-kit sync",
    "clean": "node -e \"const fs=require('fs'); for (const p of ['build','.svelte-kit']) { fs.rmSync(p,{recursive:true,force:true}); }\""
  },
  "dependencies": {
    "@hermes/core": "*",
    "dompurify": "^3.4.15",
    "marked": "^9.1.6"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "3.0.8",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^25.0.1",
    "svelte": "5.57.1",
    "svelte-check": "4.1.1",
    "typescript": "^5.7.3",
    "vite": "8.3.1",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
