{
  "name": "@hermes/cli",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Hermes terminal client.",
  "bin": {
    "hermes": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run build && node --test dist/",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@hermes/core": "^0.12.0"
  }
}
